pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Environment') {
            steps {
                sh 'touch telemetry-collector/.env'
                sh 'touch telemetry-aggregator/.env'
                sh 'touch incident-engine/.env'
            }
        }

        stage('Destroy') {
            steps {
                echo "Stopping containers and removing volumes..."
                sh 'docker compose down -v'
            }
        }
    }
}